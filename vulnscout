#!/bin/bash
set -euo pipefail

# Keep stream decisions separate: container exec does not allocate a TTY.
console_color_enabled() {
    local stream="$1" hint=""
    [[ -z "${NO_COLOR:-}" && "${TERM:-}" != dumb ]] || return 1
    if [[ "$stream" == stderr ]]; then
        hint="${_VULNSCOUT_COLOR_STDERR:-}"
    else
        hint="${_VULNSCOUT_COLOR_STDOUT:-}"
    fi
    case "$hint" in
        1) return 0 ;;
        0) return 1 ;;
    esac
    if [[ "$stream" == stderr ]]; then [[ -t 2 ]]; else [[ -t 1 ]]; fi
}

console_message() {
    local stream="$1" role="$2" code=36
    shift 2
    case "$role" in
        success) code=32 ;;
        warning) code=33 ;;
        error) code=31 ;;
        heading) code='1;36' ;;
    esac
    if console_color_enabled "$stream"; then
        printf '\033[%sm%s\033[0m\n' "$code" "$*"
    else
        printf '%s\n' "$*"
    fi
}

console_out() { console_message stdout "$@"; }
console_err() { console_message stderr "$@" >&2; }

console_help() {
    local line prefix label rest
    while IFS= read -r line || [[ -n "$line" ]]; do
        if ! console_color_enabled stdout || [[ -z "$line" ]]; then
            printf '%s\n' "$line"
        elif [[ "$line" != " "* || "$line" == *: ]]; then
            console_out heading "$line"
        elif [[ "$line" =~ ^([[:space:]]+)([^[:space:]].*)$ ]]; then
            prefix="${BASH_REMATCH[1]}"
            rest="${BASH_REMATCH[2]}"
            if [[ "$rest" == *"  "* ]]; then
                label="${rest%%  *}"
                printf '%s\033[1;36m%s\033[0m%s\n' "$prefix" "$label" "${rest#"$label"}"
            else
                printf '%s\n' "$line"
            fi
        else
            printf '%s\n' "$line"
        fi
    done
}


print_completion() {
    cat <<'EOF'
_vulnscout_files() {
    compopt -o filenames 2>/dev/null || true
    mapfile -t -O "${#COMPREPLY[@]}" COMPREPLY < <(compgen -f -- "$1")
}
_vulnscout_complete() {
    local cur prev word verb="" i k
    local data_verbs="add scan match-condition report export import refresh"
    local all_verbs="add scan match-condition report export import refresh delete list config asset start stop restart update version serve"
    COMPREPLY=()
    cur="${COMP_WORDS[COMP_CWORD]}"
    prev="${COMP_WORDS[COMP_CWORD-1]}"

    # Find the subcommand, skipping global options and the values of -p/-v.
    for ((i = 1; i < COMP_CWORD; i++)); do
        word="${COMP_WORDS[i]}"
        case "$word" in
            -p|--project|-v|--variant) i=$((i + 1)) ;;
            -*) ;;
            *) verb="$word"; break ;;
        esac
    done

    case "$prev" in
        -p|--project|-v|--variant|--condition) return 0 ;;
        --format) mapfile -t COMPREPLY < <(compgen -W "pdf html" -- "$cur"); return 0 ;;
        --timestamps) mapfile -t COMPREPLY < <(compgen -W "original current" -- "$cur"); return 0 ;;
        --spdx|--cdx|--cve-check|--yocto-vex|--openvex)
            _vulnscout_files "$cur"; return 0 ;;
        --grype)
            # 'scan --grype' is a flag; only 'add --grype' takes a path.
            if [ "$verb" != scan ]; then
                _vulnscout_files "$cur"; return 0
            fi ;;
    esac

    local globals="--dev -h --help --version"
    local scope=""
    if [[ " $data_verbs " == *" $verb "* ]]; then
        scope="-p --project -v --variant"
    fi

    local words=""
    case "$verb" in
        "")
            words="$all_verbs" ;;
        add)
            words="--spdx --cdx --cve-check --yocto-vex --openvex --grype" ;;
        scan)
            local prefix=""
            if [[ "$cur" == *,* ]]; then
                prefix="${cur%,*},"
                cur="${cur##*,}"
            fi
            local t
            for t in grype nvd osv sbom-cve-check all; do
                [[ "$t" == "$cur"* ]] && COMPREPLY+=("$prefix$t")
            done
            if [ -z "$prefix" ]; then
                mapfile -t -O "${#COMPREPLY[@]}" COMPREPLY < <(compgen -W "--grype --nvd --osv --sbom-cve-check --all $scope $globals" -- "$cur")
            fi
            return 0 ;;
        report)
            words="--format --condition"
            mapfile -t COMPREPLY < <(compgen -W "$words $scope $globals" -- "$cur")
            _vulnscout_files "$cur"
            return 0 ;;
        export)
            words="spdx cdx openvex custom-data custom-openvex context --amend" ;;
        import)
            # The kind is the first positional word; --timestamps and -v depend on it.
            local kind="" k
            for ((k = i + 1; k < COMP_CWORD; k++)); do
                case "${COMP_WORDS[k]}" in
                    -p|--project|-v|--variant) k=$((k + 1)) ;;
                    -*) ;;
                    *) kind="${COMP_WORDS[k]}"; break ;;
                esac
            done
            if [ -z "$kind" ]; then
                words="custom-data custom-openvex context"
            else
                case "$kind" in
                    custom-data) words="--timestamps"; scope="-p --project" ;;
                    custom-openvex) words="--timestamps" ;;
                    context) words="" ;;
                esac
            fi
            mapfile -t COMPREPLY < <(compgen -W "$words $scope $globals" -- "$cur")
            if [ -n "$kind" ]; then
                _vulnscout_files "$cur"
            fi
            return 0 ;;
        delete)
            words="scan outdated empty-scans orphaned-vulns --dry-run --yes" ;;
        list)
            words="projects scans --json" ;;
        config)
            words="get set unset list" ;;
        asset)
            local seen_add=false
            for ((k = i + 1; k < COMP_CWORD; k++)); do
                [ "${COMP_WORDS[k]}" = "add" ] && seen_add=true
            done
            if [ "$seen_add" = true ]; then
                _vulnscout_files "$cur"
            else
                mapfile -t COMPREPLY < <(compgen -W "add $globals" -- "$cur")
            fi
            return 0 ;;
        match-condition|refresh)
            words="" ;;
    esac
    mapfile -t COMPREPLY < <(compgen -W "$words $scope $globals" -- "$cur")
}
complete -F _vulnscout_complete vulnscout ./vulnscout
EOF
}

# Hidden verb: runs before config sourcing and container engine detection.
if [ "${1:-}" = "completion" ]; then
    if [ "${2:-}" != "bash" ] || [ $# -gt 2 ]; then
        console_err error "Error: unsupported shell. Usage: source <(vulnscout completion bash)"
        exit 1
    fi
    print_completion
    exit 0
fi

CONTAINER_NAME="${VULNSCOUT_CONTAINER:-vulnscout}"
DOCKER_IMAGE="${VULNSCOUT_IMAGE:-docker.io/sflinux/vulnscout:v0.24}"
SCRIPT_DIR="$(dirname "$(readlink -f "$0")")"
VULNSCOUT_BUILD_DIR="${VULNSCOUT_BUILD_DIR:-$SCRIPT_DIR/.vulnscout}"
VULNSCOUT_CACHE_DIR="${VULNSCOUT_CACHE_DIR:-$VULNSCOUT_BUILD_DIR/cache}"
VULNSCOUT_OUTPUTS_DIR="${VULNSCOUT_OUTPUTS_DIR:-$VULNSCOUT_BUILD_DIR/outputs}"
VULNSCOUT_CONFIG_FILE="${VULNSCOUT_CACHE_DIR}/config.env"

if command -v podman &> /dev/null; then
    CONTAINER_ENGINE="podman"
elif command -v docker &> /dev/null; then
    CONTAINER_ENGINE="docker"
else
    console_out error "Error: \"podman\" or \"docker\" is not installed or not in PATH."
    exit 1
fi

# Recover traversal before testing for files inside a private legacy cache.
if [[ -d "$VULNSCOUT_CACHE_DIR" && ! -x "$VULNSCOUT_CACHE_DIR" ]]; then
    if [[ "$CONTAINER_ENGINE" != "podman" ]] ||
        ! podman unshare chown 0:0 "$VULNSCOUT_CACHE_DIR"; then
        console_err error "Error: cannot restore host ownership of $VULNSCOUT_CACHE_DIR."
        exit 1
    fi
    if [[ ! -x "$VULNSCOUT_CACHE_DIR" ]]; then
        console_err error "Error: $VULNSCOUT_CACHE_DIR is not accessible. Restore owner search permission before retrying."
        exit 1
    fi
fi

# Source config early so stored values (e.g. VULNSCOUT_BUILD_DIR) take effect
if [ -f "$VULNSCOUT_CONFIG_FILE" ]; then
    # Older rootless Podman containers chowned the cache to a subordinate host UID.
    if [ ! -r "$VULNSCOUT_CONFIG_FILE" ]; then
        if [[ "$CONTAINER_ENGINE" != "podman" ]] ||
            ! podman unshare chown 0:0 "$VULNSCOUT_CACHE_DIR" "$VULNSCOUT_CONFIG_FILE"; then
            console_err error "Error: cannot restore host ownership of $VULNSCOUT_CONFIG_FILE. Restore its ownership to $(id -u):$(id -g) before retrying."
            exit 1
        fi
        if [ ! -r "$VULNSCOUT_CONFIG_FILE" ]; then
            console_err error "Error: $VULNSCOUT_CONFIG_FILE is not readable. Restore owner read permission before retrying."
            exit 1
        fi
    fi
    # shellcheck source=/dev/null
    . "$VULNSCOUT_CONFIG_FILE"
fi
# Re-derive VULNSCOUT_CONFIG_FILE in case VULNSCOUT_CACHE_DIR was updated by config
VULNSCOUT_CONFIG_FILE="${VULNSCOUT_CACHE_DIR}/config.env"
DOCKER_IMAGE="${VULNSCOUT_IMAGE:-$DOCKER_IMAGE}"

# Run a container command using the detected container engine on the host (podman or docker)
call_container_engine() {
    $CONTAINER_ENGINE "$@"
}

PROJECT="default"
PROJECT_SPECIFIED=false
VARIANT=""
VARIANT_SPECIFIED=false
MATCH_CONDITION=""
PENDING_ARGS=()
DEV_MODE=false

VULNSCOUT_LEGACY_REMOVAL_VERSION="v0.25"
LEGACY_TOKENS=()
SCOPE_ARGS=()

