show_help() { _show_help | console_help; }

show_verb_help() { _show_verb_help "$@" | console_help; }

exec_container() {
    local stdout=0 stderr=0
    if console_color_enabled stdout; then stdout=1; fi
    if console_color_enabled stderr; then stderr=1; fi
    call_container_engine exec \
        --env "_VULNSCOUT_COLOR_STDOUT=$stdout" \
        --env "_VULNSCOUT_COLOR_STDERR=$stderr" \
        --env "NO_COLOR=${NO_COLOR:-}" --env "TERM=${TERM:-}" \
        "$CONTAINER_NAME" /scan/src/entrypoint.sh "$@"
}

container_has_dev_mount() {
    local mounts
    mounts=$(call_container_engine inspect "$CONTAINER_NAME" \
        --format '{{range .Mounts}}{{.Destination}}{{println}}{{end}}' 2>/dev/null) || return 1
    grep -qx '/scan/src' <<< "$mounts" || return 1
    if [[ -d "$SCRIPT_DIR/vulnscout_mcp" ]]; then
        grep -qx '/scan/vulnscout_mcp' <<< "$mounts" || return 1
    fi
}

ensure_running() {
    if ! call_container_engine ps --format '{{.Names}}' | grep -q "^${CONTAINER_NAME}$"; then
        console_out info "Container not running, starting..."
        do_start
    elif [ "$DEV_MODE" = true ] && [ -d "$SCRIPT_DIR/src" ] && ! container_has_dev_mount; then
        # Otherwise the container keeps serving the image's src/, ignoring local changes
        console_out info "Container running without dev mode, restarting..."
        do_start
    fi
}

die() {
    console_err error "Error: $*"
    exit 1
}

# Copy a host file into the container and print its staged path (stdout carries only the path).
stage_file() {
    local file staged
    file="$(readlink -f "$1")"
    staged="/tmp/vulnscout_stage_$(basename "$file")"
    call_container_engine cp "$file" "$CONTAINER_NAME:$staged" >&2 || return 1
    echo "$staged"
}

add_input() {
    local staged
    staged="$(stage_file "$2")"
    PENDING_ARGS+=("--$1" "$staged")
}

# Print the entrypoint template argument: a staged path for a local file, a bare name unchanged.
stage_report_template() {
    local tpl="$1"
    if [ -f "$tpl" ]; then
        stage_file "$tpl"
    elif [[ "$tpl" == */* ]]; then
        console_err error "Error: template file not found: $tpl"
        return 1
    else
        echo "$tpl"
    fi
}

image_version() {
    call_container_engine inspect "$1" \
        --format '{{index .Config.Labels "org.opencontainers.image.version"}}' 2>/dev/null || echo unknown
}

do_version() {
    console_out info "VulnScout $(image_version "$DOCKER_IMAGE")"
}

do_update() {
    local cur_ver new_ver running_id target_id
    cur_ver="$(image_version "$DOCKER_IMAGE")"
    if call_container_engine pull "$DOCKER_IMAGE" > /dev/null 2>&1; then
        new_ver="$(image_version "$DOCKER_IMAGE")"
        if [ "$cur_ver" != "$new_ver" ]; then
            console_out success "Updated image: $cur_ver -> $new_ver"
        else
            console_out info "Image already up to date ($cur_ver)."
        fi
    else
        console_out warning "Could not pull '$DOCKER_IMAGE' (local-only or registry not reachable)."
    fi
    # Restart the container if it is running on a different image
    if call_container_engine ps --format '{{.Names}}' | grep -q "^${CONTAINER_NAME}$"; then
        running_id="$(call_container_engine inspect "$CONTAINER_NAME" --format '{{.Image}}' 2>/dev/null || true)"
        target_id="$(call_container_engine inspect "$DOCKER_IMAGE" --format '{{.Id}}' 2>/dev/null || true)"
        if [ -n "$target_id" ] && [ "$running_id" != "$target_id" ]; then
            console_out info "Restarting container on $DOCKER_IMAGE ($(image_version "$DOCKER_IMAGE"))..."
            do_start
        else
            console_out info "Container already running on the target image."
        fi
    fi
}

validate_scan_types() {
    local selection="$1" label="${2:---perform-scans}" scan_type
    local -a scan_types
    IFS=',' read -r -a scan_types <<< "$selection"
    if [[ -z "$selection" || "$selection" == ,* || "$selection" == *, || "$selection" == *,,* ]]; then
        console_err error "Error: $label requires scan types: grype, nvd, osv, sbom-cve-check, or all."
        return 1
    fi
    for scan_type in "${scan_types[@]}"; do
        case "$scan_type" in
            grype|nvd|osv|sbom-cve-check|all) ;;
            *) console_err error "Error: unknown scan type '$scan_type'. Expected grype, nvd, osv, sbom-cve-check, or all."; return 1 ;;
        esac
    done
}

# Print the new-grammar replacement for a legacy action token; return 1 for other tokens.
legacy_replacement() {
    case "$1" in
        --add-spdx|add-spdx) echo "add --spdx <path>" ;;
        --add-cdx|add-cdx) echo "add --cdx <path>" ;;
        --add-grype|add-grype) echo "add --grype <path>" ;;
        --add-openvex|add-openvex) echo "add --openvex <path>" ;;
        --add-cve-check|add-cve-check) echo "add --cve-check <path>" ;;
        --add-yocto-vex|add-yocto-vex) echo "add --yocto-vex <path>" ;;
        --add-asset|add-asset) echo "asset add <path>" ;;
        --perform-scans) echo "scan <types>" ;;
        --perform-grype-scan) echo "scan grype" ;;
        --perform-nvd-scan) echo "scan nvd" ;;
        --perform-osv-scan) echo "scan osv" ;;
        --perform-sbom-cve-check-scan) echo "scan sbom-cve-check" ;;
        --match-condition) echo "match-condition <expr>" ;;
        --refresh-vulnerability-data) echo "refresh" ;;
        --export-spdx|export-spdx) echo "export spdx" ;;
        --export-cdx|export-cdx) echo "export cdx" ;;
        --export-openvex|export-openvex) echo "export openvex" ;;
        --export-custom-vulnscout-data|export-custom-vulnscout-data) echo "export custom-data" ;;
        --export-custom-openvex-assessments|export-custom-openvex-assessments) echo "export custom-openvex" ;;
        --export-context|export-context) echo "export context" ;;
        --import-custom-vulnscout-data|import-custom-vulnscout-data) echo "import custom-data <path>" ;;
        --import-custom-openvex-assessments|import-custom-openvex-assessments) echo "import custom-openvex <path>" ;;
        --import-context|import-context) echo "import context <path>" ;;
        --list-projects|list-projects) echo "list projects" ;;
        --list-scans|list-scans) echo "list scans" ;;
        --delete-scan|delete-scan) echo "delete scan <id>" ;;
        --delete-outdated|delete-outdated) echo "delete outdated" ;;
        --delete-empty-scans|delete-empty-scans) echo "delete empty-scans" ;;
        --delete-orphaned-vulns|delete-orphaned-vulns|--delete-orphaned-vulnerabilities|delete-orphaned-vulnerabilities)
            echo "delete orphaned-vulns" ;;
        --config) echo "config set <key> <value>" ;;
        --config-list|config-list) echo "config list" ;;
        --config-clear|config-clear) echo "config unset <key>" ;;
        --serve) echo "serve" ;;
        --report) echo "report <template>" ;;
        --start) echo "start" ;;
        --stop) echo "stop" ;;
        --restart) echo "restart" ;;
        --update) echo "update" ;;
        *) return 1 ;;
    esac
}

# Legacy-only modifiers: warned about in legacy calls, but they do not select the legacy grammar.
legacy_modifier_replacement() {
    case "$1" in
        --use-original-timestamps) echo "import <kind> <path> --timestamps original" ;;
        --use-current-timestamps) echo "import <kind> <path> --timestamps current" ;;
        amend) echo "export <kind> --amend" ;;
        *) return 1 ;;
    esac
}

# Collect legacy tokens into LEGACY_TOKENS; return 0 when the call uses the legacy grammar.
# Values of -p/--project/-v/--variant are skipped, so "-p list-scans" is not a legacy token.
find_legacy_tokens() {
    local is_legacy=1 skip_value=false seen_command=false
    LEGACY_TOKENS=()
    while [ $# -gt 0 ]; do
        if [ "$skip_value" = true ]; then
            skip_value=false
        else
            case "$1" in
                -p|--project|-v|--variant)
                    skip_value=true ;;
                --dev|-h|--help|--version)
                    ;;
                start|stop|restart|update|version|serve|add|scan|match-condition|refresh|asset|report|export|import|delete|list)
                    # A new-grammar verb as first command: the rest are its arguments, never legacy flags.
                    if [ "$seen_command" = false ]; then
                        return 1
                    fi ;;
                config)
                    if [ "$seen_command" = false ] && { [ $# -lt 3 ] || case "$2" in -*|get|set|unset|list) true ;; *) false ;; esac; }; then
                        return 1
                    fi
                    seen_command=true
                    # Legacy "config KEY VALUE" always has a key and a value. "config get|set|unset|list",
                    # "config --help", "help config" and typos such as "config show" use the new grammar.
                    if [ $# -ge 3 ]; then
                        case "$2" in
                            -*|get|set|unset|list) ;;
                            *) LEGACY_TOKENS+=("$1"); is_legacy=0 ;;
                        esac
                    fi ;;
                *)
                    seen_command=true
                    if legacy_replacement "$1" > /dev/null; then
                        LEGACY_TOKENS+=("$1"); is_legacy=0
                    elif legacy_modifier_replacement "$1" > /dev/null; then
                        LEGACY_TOKENS+=("$1")
                    fi ;;
            esac
        fi
        shift
    done
    return "$is_legacy"
}

warn_legacy_tokens() {
    if [ "${VULNSCOUT_NO_DEPRECATION_WARNING:-}" = 1 ]; then
        return 0
    fi
    local token replacement
    local -A seen=()
    for token in "${LEGACY_TOKENS[@]}"; do
        if [ -n "${seen[$token]:-}" ]; then
            continue
        fi
        seen[$token]=1
        if [ "$token" = config ]; then
            replacement="config set <key> <value>"
        elif ! replacement="$(legacy_replacement "$token")"; then
            replacement="$(legacy_modifier_replacement "$token")"
        fi
        console_err warning "deprecated: $token (removed in $VULNSCOUT_LEGACY_REMOVAL_VERSION); use 'vulnscout $replacement'"
    done
}

config_set() {
    local key="$1"
    local value="$2"
    mkdir -p "$(dirname "$VULNSCOUT_CONFIG_FILE")"
    touch "$VULNSCOUT_CONFIG_FILE"
    local tmp
    tmp=$(mktemp)
    grep -v "^${key}=" "$VULNSCOUT_CONFIG_FILE" > "$tmp" || true
    echo "${key}=${value}" >> "$tmp"
    cat "$tmp" > "$VULNSCOUT_CONFIG_FILE"
    rm -f "$tmp"
    console_out success "Config set: $key=$value"
    # Restart the container so volume mounts reflect the new cache dir
    if [ "$key" = "VULNSCOUT_CACHE_DIR" ] && call_container_engine ps --format '{{.Names}}' | grep -q "^${CONTAINER_NAME}$"; then
        console_out info "Restarting container to apply new VULNSCOUT_CACHE_DIR..."
        VULNSCOUT_CACHE_DIR="$value"
        do_start
    fi
}

config_clear() {
    local key="$1"
    touch "$VULNSCOUT_CONFIG_FILE"
    local tmp
    tmp=$(mktemp)
    grep -v "^${key}=" "$VULNSCOUT_CONFIG_FILE" > "$tmp" || true
    cat "$tmp" > "$VULNSCOUT_CONFIG_FILE"
    rm -f "$tmp"
    console_out success "Config cleared: $key"
}

do_start() {
    call_container_engine rm -f "$CONTAINER_NAME" 2>/dev/null || true
    mkdir -p "$VULNSCOUT_CACHE_DIR" "$VULNSCOUT_OUTPUTS_DIR" "$(dirname "$VULNSCOUT_CONFIG_FILE")"

    if [[ $CONTAINER_ENGINE = "docker" ]]; then
        # Docker bind-mounts create root-owned directories on the host when a path
        # doesn't exist yet. Use a temporary container (running as root) to clean up
        # any such stale paths and re-chown the cache/outputs dirs to the current user.
        local uid gid
        uid="$(id -u)"; gid="$(id -g)"
        docker run --rm \
            --entrypoint sh \
            -v "$VULNSCOUT_CACHE_DIR:/mnt/cache" \
            -v "$VULNSCOUT_OUTPUTS_DIR:/mnt/outputs" \
            "$DOCKER_IMAGE" \
            -c "[ -f /mnt/cache/config.env ] && [ \"\$(stat -c %u /mnt/cache/config.env)\" = '0' ] && rm -f /mnt/cache/config.env; chown -R ${uid}:${gid} /mnt/cache /mnt/outputs" \
            2>/dev/null || true
    fi
    if [ ! -f "$VULNSCOUT_CONFIG_FILE" ]; then
        cat > "$VULNSCOUT_CONFIG_FILE" <<EOF
FLASK_RUN_PORT=7275
FLASK_RUN_HOST=0.0.0.0
IGNORE_PARSING_ERRORS=false
VERBOSE_MODE=false
USER_UID=$(id -u)
USER_GID=$(id -g)
VITE_API_URL=
REFRESH_REMOTE_DELAY=2w
# GRYPE_MEMLIMIT — cap RAM used by the grype binary (Go soft memory limit).
# Unset = auto (~80 % of the container/cgroup memory limit, recommended).
# Explicit value examples: 4GiB  8GiB  24GiB  6442450944
# Set to "off" to disable the limit entirely.
#GRYPE_MEMLIMIT=
EOF
        console_out success "Created default config at $VULNSCOUT_CONFIG_FILE"
    fi
    chmod 600 "$VULNSCOUT_CONFIG_FILE"
    # The sbom-cve-check advisory databases (NVD-FKIE + CVEList) live inside the
    # VulnScout cache directory by default (local_databases sub-folder next to
    # vulnscout.db), so the existing cache mount already covers them and no extra
    # mount is needed.  An explicit VULNSCOUT_SBOM_CVE_CHECK_DB_DIR override (e.g. a
    # shared host clone) is mounted separately and pointed at by
    # SBOM_CVE_CHECK_DATABASES_DIR.
    local _sbom_cve_check_host_db="${VULNSCOUT_SBOM_CVE_CHECK_DB_DIR:-}"

    local -a env_args=()
    while IFS='=' read -r key value; do
        [ -z "$key" ] && continue
        [ "${key#\#}" = "$key" ] || continue
        case "$key" in
            AI_PROVIDER|AI_AUTH_CREDENTIALS|AI_MODEL|AI_BASE_URL) continue ;;
        esac
        env_args+=(-e "${key}=${value}")
    done < "$VULNSCOUT_CONFIG_FILE"
    # Pass SBOM_CVE_CHECK_AUTO_UPDATE from the host environment so the operator can
    # override the container default (1 = on) e.g. to run offline (SBOM_CVE_CHECK_AUTO_UPDATE=0).
    [[ -n "${SBOM_CVE_CHECK_AUTO_UPDATE:-}" ]] && env_args+=(-e "SBOM_CVE_CHECK_AUTO_UPDATE=$SBOM_CVE_CHECK_AUTO_UPDATE")
    # Forward GRYPE_MEMLIMIT from the host so operators can cap grype RAM usage
    # without editing config.env (e.g. export GRYPE_MEMLIMIT=24GiB before running).
    [[ -n "${GRYPE_MEMLIMIT:-}" ]] && env_args+=(-e "GRYPE_MEMLIMIT=$GRYPE_MEMLIMIT")
    local -a vol_args=(
        -v "$VULNSCOUT_CACHE_DIR:/cache/vulnscout:Z"
        -v "$VULNSCOUT_OUTPUTS_DIR:/scan/outputs:Z"
        -v "$VULNSCOUT_CONFIG_FILE:/etc/vulnscout/config.env:Z"
    )
    if [[ -n "$_sbom_cve_check_host_db" ]]; then
        mkdir -p "$_sbom_cve_check_host_db"
        vol_args+=(-v "$_sbom_cve_check_host_db:/local_databases:Z")
        env_args+=(-e "SBOM_CVE_CHECK_DATABASES_DIR=/local_databases")
    fi
    if [ "$DEV_MODE" = true ] && [ -d "$SCRIPT_DIR/src" ]; then
        vol_args+=(-v "$SCRIPT_DIR/src":/scan/src:Z)
        if [[ -d "$SCRIPT_DIR/vulnscout_mcp" ]]; then
            vol_args+=(-v "$SCRIPT_DIR/vulnscout_mcp":/scan/vulnscout_mcp:Z)
        fi
        env_args+=(-e DEV_MODE=true)
        console_out info "Dev mode: mounting $SCRIPT_DIR/src into /scan/src"
    fi

    local -a userns_args=()
    if [[ "$CONTAINER_ENGINE" = "podman" ]]; then
        local rootless
        rootless=$(call_container_engine info --format '{{.Host.Security.Rootless}}')
        if [[ "$rootless" = "true" ]]; then
            # Container root must own private host files and bind-mounted directories.
            userns_args+=("--userns=keep-id:uid=0,gid=0" --user=0:0)
            env_args+=(-e VULNSCOUT_ROOTLESS_PODMAN=true)
        fi
    fi

    call_container_engine run -d --name "$CONTAINER_NAME" \
        "${userns_args[@]}" \
        -p 7275:7275 \
        "${env_args[@]}" \
        "${vol_args[@]}" \
        "$DOCKER_IMAGE" daemon
    # Wait for the container process to be ready to accept exec calls
    local retries=15
    until call_container_engine exec "$CONTAINER_NAME" true 2>/dev/null; do
        retries=$((retries - 1))
        if [ "$retries" -le 0 ]; then
            console_out error "Error: container failed to start. Check '$CONTAINER_ENGINE logs $CONTAINER_NAME'."
            exit 1
        fi
        sleep 1
    done
}

start_frontend_dev() {
    if ! command -v npm &>/dev/null; then
        console_out error "Error: npm is not installed or not in PATH."
        exit 1
    fi

    local frontend_dir="$SCRIPT_DIR/frontend"
    if [ ! -d "$frontend_dir" ]; then
        console_out warning "Warning: frontend/ not found at $frontend_dir, skipping dev server."
        return
    fi

    local dev_api_url="${VITE_API_URL:-}"
    # Old generated configs pointed the browser at localhost, which may resolve
    # to IPv6 even though the container publishes only an IPv4 port.
    [ "$dev_api_url" = "http://localhost:7275" ] && dev_api_url=""
    if [ ! -f "$frontend_dir/.env" ] ||
        [ "$(cat "$frontend_dir/.env")" = 'VITE_API_URL="http://localhost:7275"' ] ||
        [ "$(cat "$frontend_dir/.env")" = 'VITE_API_URL=""' ]; then
        printf 'VITE_API_URL="%s"\n' "$dev_api_url" > "$frontend_dir/.env"
    fi

    if [ ! -d "$frontend_dir/node_modules" ]; then
        console_out info "node_modules not found. Running npm install..."
        (cd "$frontend_dir" && npm install)
    fi

    console_out info "Starting frontend dev server..."
    (cd "$frontend_dir" && npm run dev) &
    local npm_pid=$!
    echo "$npm_pid" > "$SCRIPT_DIR/.vulnscout-npm.pid"
    console_out success "Frontend dev server started (PID $npm_pid)"

    # shellcheck disable=SC2329
    # (does not handle function used in trap)
    _cleanup_frontend() {
        if [ -f "$SCRIPT_DIR/.vulnscout-npm.pid" ]; then
            local pid
            pid=$(cat "$SCRIPT_DIR/.vulnscout-npm.pid")
            console_out info "Stopping frontend dev server (PID $pid)..."
            kill -- "-$(ps -o pgid= "$pid" 2>/dev/null | tr -d ' ')" 2>/dev/null || kill "$pid" 2>/dev/null || true
            wait "$pid" 2>/dev/null || true
            rm -f "$SCRIPT_DIR/.vulnscout-npm.pid"
        fi
    }
    trap _cleanup_frontend SIGINT SIGTERM EXIT
}

# require_value <option> <remaining argc> <next token>
require_value() {
    if [ "$2" -lt 2 ] || [[ "$3" == -* ]]; then
        die "$1 requires a value."
    fi
}

reject_scope() {
    if [ "$PROJECT_SPECIFIED" = true ] || [ "$VARIANT_SPECIFIED" = true ]; then
        die "'$1' does not accept --project or --variant."
    fi
}

# Send only the scope options the user gave; the entrypoint applies its own defaults.
set_explicit_scope_args() {
    SCOPE_ARGS=()
    if [ "$PROJECT_SPECIFIED" = true ]; then
        SCOPE_ARGS+=(--project "$PROJECT")
    fi
    if [ "$VARIANT_SPECIFIED" = true ]; then
        SCOPE_ARGS+=(--variant "$VARIANT")
    fi
}

# Always send --project ("default" if not given); --variant only if given.
set_project_scope_args() {
    SCOPE_ARGS=(--project "$PROJECT")
    if [ "$VARIANT_SPECIFIED" = true ]; then
        SCOPE_ARGS+=(--variant "$VARIANT")
    fi
}

reject_option() {
    local verb="$1" token="$2"
    case "$token" in
        --use-original-timestamps|--use-current-timestamps)
            die "'$verb' does not accept $token; use 'import <kind> <path> --timestamps original|current'." ;;
        amend)
            die "'$verb' does not accept argument 'amend'; use 'export <kind> --amend'." ;;
        -*)
            die "'$verb' does not accept option $token." ;;
        *)
            die "'$verb' does not accept argument '$token'." ;;
    esac
}

require_no_args() {
    local verb="$1"
    shift
    if [ $# -gt 0 ]; then
        reject_option "$verb" "$1"
    fi
}

require_file() {
    if [ ! -f "$1" ]; then
        die "file not found: $1"
    fi
}

verb_start() {
    reject_scope start
    require_no_args start "$@"
    do_start
    if [ "$DEV_MODE" = true ]; then
        start_frontend_dev
    fi
}

verb_stop() {
    reject_scope stop
    require_no_args stop "$@"
    call_container_engine rm -f "$CONTAINER_NAME"
}

verb_restart() {
    reject_scope restart
    require_no_args restart "$@"
    call_container_engine rm -f "$CONTAINER_NAME" 2>/dev/null || true
    do_start
    if [ "$DEV_MODE" = true ]; then
        start_frontend_dev
    fi
}

verb_update() {
    reject_scope update
    require_no_args update "$@"
    do_update
}

verb_version() {
    reject_scope version
    require_no_args version "$@"
    do_version
}

verb_serve() {
    reject_scope serve
    require_no_args serve "$@"
    ensure_running
    # Kill any previous Flask process to free port 7275
    call_container_engine exec "$CONTAINER_NAME" pkill -f 'flask.*run' 2>/dev/null || true
    sleep 1
    if [ "$DEV_MODE" = true ]; then
        start_frontend_dev
    fi
    exec_container --serve
}

verb_add() {
    local i
    local -a inputs=()
    while [ $# -gt 0 ]; do
        case "$1" in
            --spdx|--cdx|--cve-check|--yocto-vex|--openvex|--grype)
                if [ $# -lt 2 ]; then
                    die "add $1 requires a path."
                fi
                require_file "$2"
                inputs+=("add-${1#--}" "$2")
                shift 2 ;;
            *)
                reject_option add "$1" ;;
        esac
    done
    if [ ${#inputs[@]} -eq 0 ]; then
        die "'add' needs at least one input option: --spdx, --cdx, --cve-check, --yocto-vex, --openvex, or --grype."
    fi
    ensure_running
    for ((i = 0; i < ${#inputs[@]}; i += 2)); do
        add_input "${inputs[i]}" "${inputs[i + 1]}"
    done
    set_explicit_scope_args
    exec_container "${SCOPE_ARGS[@]}" "${PENDING_ARGS[@]}"
}

# Print the canonical selection for the given scan types: "all", or the
# de-duplicated types in execution order (grype, nvd, osv, sbom-cve-check).
normalize_scan_selection() {
    local scan_type selected=" $* " selection=""
    if [ $# -eq 0 ] || [[ "$selected" == *" all "* ]]; then
        echo all
        return
    fi
    for scan_type in grype nvd osv sbom-cve-check; do
        if [[ "$selected" == *" $scan_type "* ]]; then
            selection+="${selection:+,}$scan_type"
        fi
    done
    echo "$selection"
}

verb_scan() {
    local -a requested=() scan_types=()
    while [ $# -gt 0 ]; do
        case "$1" in
            --grype|--nvd|--osv|--sbom-cve-check|--all)
                requested+=("${1#--}") ;;
            -*)
                die "'scan' does not accept option $1. Expected --grype, --nvd, --osv, --sbom-cve-check, or --all." ;;
            *)
                validate_scan_types "$1" scan || exit 1
                IFS=',' read -r -a scan_types <<< "$1"
                requested+=("${scan_types[@]}") ;;
        esac
        shift
    done
    local selection
    selection="$(normalize_scan_selection "${requested[@]}")"
    ensure_running
    set_explicit_scope_args
    # One entrypoint call: all selected scanners share one scan run (transaction block).
    exec_container "${SCOPE_ARGS[@]}" --perform-scans "$selection"
}

verb_match_condition() {
    if [ $# -ne 1 ]; then
        die "'match-condition' needs exactly one condition expression, e.g. vulnscout match-condition \"cvss >= 9.0\"."
    fi
    if [ -z "$1" ]; then
        die "match-condition requires a non-empty condition"
    fi
    if [ "$VARIANT_SPECIFIED" = true ] && [ "$PROJECT_SPECIFIED" = false ]; then
        die "'match-condition' --variant requires --project."
    fi
    ensure_running
    set_explicit_scope_args
    # Exit 2 (condition matched) propagates as the wrapper's exit code.
    exec_container "${SCOPE_ARGS[@]}" --match-condition "$1"
}

verb_refresh() {
    require_no_args refresh "$@"
    if [ "$VARIANT_SPECIFIED" = true ] && [ "$PROJECT_SPECIFIED" = false ]; then
        die "'refresh' --variant requires --project."
    fi
    ensure_running
    set_explicit_scope_args
    exec_container "${SCOPE_ARGS[@]}" --refresh-vulnerability-data
}

verb_asset() {
    local path
    reject_scope asset
    if [ "${1:-}" != add ]; then
        die "usage: vulnscout asset add <path>..."
    fi
    shift
    if [ $# -eq 0 ]; then
        die "'asset add' needs at least one path."
    fi
    for path in "$@"; do
        if [[ "$path" == -* ]]; then
            reject_option "asset add" "$path"
        fi
        require_file "$path"
    done
    ensure_running
    for path in "$@"; do
        add_input add-asset "$path"
    done
    exec_container "${PENDING_ARGS[@]}"
}

verb_report() {
    local format="" condition="" status=0 tpl staged
    local -a templates=() report_args=()
    while [ $# -gt 0 ]; do
        case "$1" in
            --format)
                if [ $# -lt 2 ]; then
                    die "report --format requires pdf or html."
                fi
                case "$2" in
                    pdf|html) format="$2" ;;
                    *) die "report --format must be pdf or html, got '$2'." ;;
                esac
                shift 2 ;;
            --condition)
                if [ $# -lt 2 ]; then
                    die "report --condition requires an expression."
                fi
                condition="$2"
                shift 2 ;;
            -*)
                reject_option report "$1" ;;
            *)
                templates+=("$1")
                shift ;;
        esac
    done
    if [ ${#templates[@]} -eq 0 ]; then
        die "'report' needs at least one template name or path."
    fi
    for tpl in "${templates[@]}"; do
        if [[ "$tpl" == */* ]] && [ ! -f "$tpl" ]; then
            die "template file not found: $tpl"
        fi
    done
    ensure_running
    set_project_scope_args
    if [ -n "$condition" ]; then
        report_args+=(--match-condition "$condition")
    fi
    for tpl in "${templates[@]}"; do
        staged="$(stage_report_template "$tpl")"
        report_args+=(--report "$staged")
    done
    if [ -n "$format" ]; then
        report_args+=(--report-format "$format")
    fi
    exec_container "${SCOPE_ARGS[@]}" "${report_args[@]}" || status=$?
    # 'match-condition' is the gate: with --condition, a match (exit 2) still means the report was written.
    if [ "$status" -eq 2 ] && [ -n "$condition" ]; then
        return 0
    fi
    return "$status"
}

verb_export() {
    local amend=false has_custom=false kind
    local -a kinds=() export_args=()
    while [ $# -gt 0 ]; do
        case "$1" in
            --amend) amend=true ;;
            spdx|cdx|openvex|context) kinds+=("$1") ;;
            custom-data|custom-openvex) kinds+=("$1"); has_custom=true ;;
            -*|amend) reject_option export "$1" ;;
            *) die "unknown export kind '$1'. Expected spdx, cdx, openvex, custom-data, custom-openvex, or context." ;;
        esac
        shift
    done
    if [ ${#kinds[@]} -eq 0 ]; then
        die "'export' needs at least one kind: spdx, cdx, openvex, custom-data, custom-openvex, or context."
    fi
    if [ "$amend" = true ] && [ "$has_custom" = false ]; then
        die "--amend only applies to the custom-data and custom-openvex exports."
    fi
    for kind in "${kinds[@]}"; do
        case "$kind" in
            spdx) export_args+=(--export-spdx) ;;
            cdx) export_args+=(--export-cdx) ;;
            openvex) export_args+=(--export-openvex) ;;
            custom-data) export_args+=(--export-custom-vulnscout-data) ;;
            custom-openvex)
                export_args+=(--export-custom-openvex-assessments)
                # D8: without --variant, export every variant of the project.
                if [ "$VARIANT_SPECIFIED" = false ]; then
                    export_args+=(--all-variants)
                fi ;;
            context) export_args+=(--export-context) ;;
        esac
    done
    if [ "$amend" = true ]; then
        export_args+=(--amend)
    fi
    ensure_running
    set_project_scope_args
    exec_container "${SCOPE_ARGS[@]}" "${export_args[@]}"
}

verb_import() {
    local kind="${1:-}" path="" timestamps="" staged
    local -a import_args=()
    case "$kind" in
        custom-data|custom-openvex|context) ;;
        spdx|cdx|openvex|grype|cve-check|yocto-vex)
            die "use 'vulnscout add --$kind <path>' for SBOMs and scan results." ;;
        "")
            die "'import' needs a kind and a path: custom-data, custom-openvex, or context." ;;
        *)
            die "unknown import kind '$kind'. Expected custom-data, custom-openvex, or context." ;;
    esac
    shift
    while [ $# -gt 0 ]; do
        case "$1" in
            --timestamps)
                if [ "$kind" = context ]; then
                    die "'import context' does not accept --timestamps."
                fi
                if [ $# -lt 2 ]; then
                    die "--timestamps requires original or current."
                fi
                case "$2" in
                    original|current) timestamps="$2" ;;
                    *) die "--timestamps must be original or current, got '$2'." ;;
                esac
                shift 2 ;;
            -*)
                reject_option import "$1" ;;
            *)
                if [ -n "$path" ]; then
                    reject_option import "$1"
                fi
                path="$1"
                shift ;;
        esac
    done
    if [ -z "$path" ]; then
        die "'import $kind' needs a file path."
    fi
    require_file "$path"
    case "$kind" in
        custom-data)
            if [ "$VARIANT_SPECIFIED" = true ]; then
                die "'import custom-data' does not accept --variant; variants come from the file."
            fi
            SCOPE_ARGS=(--project "$PROJECT") ;;
        custom-openvex)
            set_project_scope_args
            # D8: without --variant, the Flask command picks the project's only variant.
            if [ "$VARIANT_SPECIFIED" = false ]; then
                import_args+=(--all-variants)
            fi ;;
        context)
            if [ "$VARIANT_SPECIFIED" = true ] && [ "$PROJECT_SPECIFIED" = false ]; then
                die "'import context' --variant requires --project."
            fi
            set_explicit_scope_args
            # D7: with --project, retarget the file's entries instead of using the names it holds.
            if [ "$PROJECT_SPECIFIED" = true ]; then
                import_args+=(--retarget-context)
            fi ;;
    esac
    if [ -n "$timestamps" ]; then
        import_args+=("--use-$timestamps-timestamps")
    fi
    ensure_running
    staged="$(stage_file "$path")"
    case "$kind" in
        custom-data) import_args+=(--import-custom-vulnscout-data "$staged") ;;
        custom-openvex) import_args+=(--import-custom-openvex-assessments "$staged") ;;
        context) import_args+=(--import-context "$staged") ;;
    esac
    exec_container "${SCOPE_ARGS[@]}" "${import_args[@]}"
}

stdin_is_tty() {
    [ -t 0 ]
}

verb_delete() {
    local target="${1:-}" dry_run=false yes=false answer=""
    local -a delete_args=()
    reject_scope delete
    case "$target" in
        scan)
            if [ $# -lt 2 ] || [[ "$2" == -* ]]; then
                die "'delete scan' needs a scan ID; run 'vulnscout list scans'."
            fi
            delete_args=(--delete-scan "$2")
            shift 2 ;;
        outdated)
            delete_args=(--delete-outdated); shift ;;
        empty-scans)
            delete_args=(--delete-empty-scans); shift ;;
        orphaned-vulns|orphaned-vulnerabilities)
            delete_args=(--delete-orphaned-vulns); shift ;;
        "")
            die "'delete' needs a target: scan <id>, outdated, empty-scans, or orphaned-vulns." ;;
        *)
            die "unknown delete target '$target'. Expected scan <id>, outdated, empty-scans, or orphaned-vulns." ;;
    esac
    while [ $# -gt 0 ]; do
        case "$1" in
            --dry-run) dry_run=true ;;
            --yes) yes=true ;;
            *) reject_option delete "$1" ;;
        esac
        shift
    done
    ensure_running
    if [ "$dry_run" = true ]; then
        exec_container --dry-run "${delete_args[@]}"
        return 0
    fi
    # Ask only on a terminal, so CI jobs keep deleting without input.
    if [ "$yes" = false ] && stdin_is_tty; then
        exec_container --dry-run "${delete_args[@]}"
        read -r -p "Proceed with deletion? [y/N] " answer || true
        case "$answer" in
            y|Y|yes|Yes) ;;
            *)
                console_err warning "Aborted."
                return 1 ;;
        esac
    fi
    exec_container "${delete_args[@]}"
}

verb_list() {
    local target="${1:-}" json=false
    reject_scope list
    case "$target" in
        projects|scans) shift ;;
        "") die "'list' needs projects or scans." ;;
        *) die "unknown list target '$target'. Expected projects or scans." ;;
    esac
    while [ $# -gt 0 ]; do
        case "$1" in
            --json) json=true ;;
            *) reject_option list "$1" ;;
        esac
        shift
    done
    ensure_running
    if [ "$json" = true ]; then
        exec_container "--list-$target" --json
    else
        exec_container "--list-$target"
    fi
}

validate_config_key() {
    if [[ ! "$1" =~ ^[A-Za-z_][A-Za-z0-9_]*$ ]]; then
        die "invalid config key '$1'; use letters, digits and underscores."
    fi
}

verb_config() {
    local action="${1:-}" line
    reject_scope config
    case "$action" in
        get)
            if [ $# -ne 2 ]; then
                die "usage: vulnscout config get <key>"
            fi
            validate_config_key "$2"
            line="$(grep "^$2=" "$VULNSCOUT_CONFIG_FILE" 2>/dev/null | tail -n 1 || true)"
            if [ -z "$line" ]; then
                die "config key not set: $2"
            fi
            echo "${line#*=}" ;;
        set)
            if [ $# -ne 3 ]; then
                die "usage: vulnscout config set <key> <value>"
            fi
            validate_config_key "$2"
            config_set "$2" "$3" ;;
        unset)
            if [ $# -ne 2 ]; then
                die "usage: vulnscout config unset <key>"
            fi
            validate_config_key "$2"
            config_clear "$2" ;;
        list)
            if [ $# -gt 1 ]; then
                reject_option "config list" "$2"
            fi
            if [ -f "$VULNSCOUT_CONFIG_FILE" ]; then
                sed -E 's/^([A-Za-z0-9_]*(API_KEY|PASSWORD|SECRET)[A-Za-z0-9_]*)=.+/\1=****/' "$VULNSCOUT_CONFIG_FILE"
            else
                console_out info "No config file found."
            fi ;;
        "")
            die "'config' needs get, set, unset, or list." ;;
        *)
            die "unknown config action '$action'. Expected get, set, unset, or list." ;;
    esac
}

parse_new() {
    local help=false verb
    local -a rest=()
    while [ $# -gt 0 ]; do
        case "$1" in
            -p|--project|-v|--variant)
                if [ ${#rest[@]} -eq 0 ]; then
                    die "'$1' is a command option; put it after the command (e.g. 'vulnscout export $1 <value> ...')."
                fi
                require_value "$1" "$#" "${2:-}"
                case "$1" in
                    -p|--project) PROJECT="$2"; PROJECT_SPECIFIED=true ;;
                    *) VARIANT="$2"; VARIANT_SPECIFIED=true ;;
                esac
                shift 2 ;;
            --dev)
                DEV_MODE=true; shift ;;
            -h|--help)
                help=true; shift ;;
            --version)
                do_version
                return 0 ;;
            *)
                rest+=("$1"); shift ;;
        esac
    done
    if [ ${#rest[@]} -eq 0 ]; then
        if [ "$help" = true ]; then
            show_help
            return 0
        fi
        die "missing command. Run 'vulnscout --help' for usage."
    fi
    verb="${rest[0]}"
    rest=("${rest[@]:1}")
    if [ "$help" = true ]; then
        show_verb_help "$verb"
        return
    fi
    case "$verb" in
        start) verb_start "${rest[@]}" ;;
        stop) verb_stop "${rest[@]}" ;;
        restart) verb_restart "${rest[@]}" ;;
        update) verb_update "${rest[@]}" ;;
        version) verb_version "${rest[@]}" ;;
        serve) verb_serve "${rest[@]}" ;;
        add) verb_add "${rest[@]}" ;;
        scan) verb_scan "${rest[@]}" ;;
        match-condition) verb_match_condition "${rest[@]}" ;;
        refresh) verb_refresh "${rest[@]}" ;;
        asset) verb_asset "${rest[@]}" ;;
        report) verb_report "${rest[@]}" ;;
        export) verb_export "${rest[@]}" ;;
        import) verb_import "${rest[@]}" ;;
        delete) verb_delete "${rest[@]}" ;;
        list) verb_list "${rest[@]}" ;;
        config) verb_config "${rest[@]}" ;;
        *)
            console_err error "Unknown command: $verb"
            console_err info "Run 'vulnscout --help' for usage."
            return 1 ;;
    esac
}

parse_legacy() {
    # Pre-scan args for --dev so it takes effect regardless of position
    for _arg in "$@"; do
        [ "$_arg" = "--dev" ] && DEV_MODE=true
    done
    local SERVE_REQUESTED=false
    local REPORT_ARGS=()
    local EXPORT_ARGS=()
    local DATA_REQUESTED=""
    local DATA_ARGS=()
    while [ $# -gt 0 ]; do
        case "$1" in
            --dev)
                DEV_MODE=true; shift ;;
            -p|--project)
                PROJECT="$2"; PROJECT_SPECIFIED=true; shift 2 ;;
            -v|--variant)
                VARIANT="$2"; VARIANT_SPECIFIED=true; shift 2 ;;
            --match-condition)
                MATCH_CONDITION="$2"; shift 2 ;;
            add-spdx|--add-spdx|add-cve-check|--add-cve-check|add-yocto-vex|--add-yocto-vex|add-openvex|--add-openvex|add-cdx|--add-cdx|add-grype|--add-grype)
                ensure_running; add_input "${1#--}" "$2"; shift 2 ;;
            --refresh-vulnerability-data)
                ensure_running; REFRESH_VULNERABILITY_DATA=true; shift ;;
            add-asset|--add-asset)
                ensure_running; add_input add-asset "$2"; shift 2 ;;
            --perform-scans)
                if [[ $# -lt 2 || "$2" == --* ]]; then
                    console_err error "Error: --perform-scans requires a scan type."; exit 1
                fi
                validate_scan_types "$2"
                ensure_running
                PENDING_ARGS+=(--perform-scans "$2"); shift 2 ;;
            --perform-grype-scan)
                ensure_running; PENDING_ARGS+=(--perform-grype-scan); shift ;;
            --perform-nvd-scan)
                ensure_running; PENDING_ARGS+=(--perform-nvd-scan); shift ;;
            --perform-osv-scan)
                ensure_running; PENDING_ARGS+=(--perform-osv-scan); shift ;;
            --perform-sbom-cve-check-scan)
                ensure_running; PENDING_ARGS+=(--perform-sbom-cve-check-scan); shift ;;
            export-spdx|--export-spdx)
                ensure_running; EXPORT_ARGS+=(--export-spdx); shift ;;
            export-cdx|--export-cdx)
                ensure_running; EXPORT_ARGS+=(--export-cdx); shift ;;
            export-openvex|--export-openvex)
                ensure_running; EXPORT_ARGS+=(--export-openvex); shift ;;
            export-custom-vulnscout-data|--export-custom-vulnscout-data)
                ensure_running; EXPORT_ARGS+=(--export-custom-vulnscout-data); shift ;;
            export-custom-openvex-assessments|--export-custom-openvex-assessments)
                ensure_running; EXPORT_ARGS+=(--export-custom-openvex-assessments); shift ;;
            amend|--amend)
                EXPORT_ARGS+=(--amend); shift ;;
            import-custom-vulnscout-data|--import-custom-vulnscout-data)
                ensure_running
                local import_staged
                import_staged="$(stage_file "$2")"
                EXPORT_ARGS+=(--import-custom-vulnscout-data "$import_staged")
                shift 2 ;;
            import-custom-openvex-assessments|--import-custom-openvex-assessments)
                ensure_running
                local import_staged
                import_staged="$(stage_file "$2")"
                EXPORT_ARGS+=(--import-custom-openvex-assessments "$import_staged")
                shift 2 ;;
            export-context|--export-context)
                ensure_running; EXPORT_ARGS+=(--export-context); shift ;;
            import-context|--import-context)
                ensure_running
                local import_staged
                import_staged="$(stage_file "$2")"
                EXPORT_ARGS+=(--import-context "$import_staged")
                shift 2 ;;
            --use-original-timestamps)
                EXPORT_ARGS+=(--use-original-timestamps); shift ;;
            --use-current-timestamps)
                EXPORT_ARGS+=(--use-current-timestamps); shift ;;
            delete-scan|--delete-scan)
                ensure_running
                exec_container --delete-scan "$2"
                shift 2 ;;
            delete-outdated|--delete-outdated)
                ensure_running
                exec_container --delete-outdated
                shift ;;
            delete-empty-scans|--delete-empty-scans)
                ensure_running
                exec_container --delete-empty-scans
                shift ;;
            delete-orphaned-vulns|--delete-orphaned-vulns|delete-orphaned-vulnerabilities|--delete-orphaned-vulnerabilities)
                ensure_running
                exec_container --delete-orphaned-vulns
                shift ;;
            serve|--serve)
                SERVE_REQUESTED=true; shift ;;
            report|--report)
                ensure_running
                local tpl
                tpl="$(stage_report_template "$2")"
                REPORT_ARGS+=(--report "$tpl")
                shift 2 ;;
            list-projects|--list-projects|list-scans|--list-scans)
                ensure_running
                command="${1#--}"
                if [[ "$DATA_REQUESTED" != "" ]]; then
                    # Only 1 data request command is allowed at the same time
                    console_out error "Cannot use $command and $DATA_REQUESTED together"
                    exit 1
                fi
                DATA_REQUESTED="$command"
                shift ;;
            --json)
                DATA_ARGS+=(--json); shift ;;
            start|--start)
                do_start
                if [ "$DEV_MODE" = true ]; then
                    start_frontend_dev
                fi
                shift ;;
            stop|--stop)
                call_container_engine rm -f "$CONTAINER_NAME"; shift ;;
            restart|--restart)
                call_container_engine rm -f "$CONTAINER_NAME" 2>/dev/null || true
                do_start
                if [ "$DEV_MODE" = true ]; then
                    start_frontend_dev
                fi
                shift ;;
            config|--config)
                config_set "$2" "$3"; shift 3 ;;
            config-list|--config-list)
                sed 's/\(API_KEY\|PASSWORD\|SECRET\|AI_AUTH_CREDENTIALS\)=.*/\1=****/' \
                    "$VULNSCOUT_CONFIG_FILE" 2>/dev/null || console_out info "No config file found."
                shift ;;
            config-clear|--config-clear)
                config_clear "$2"; shift 2 ;;
            help|--help|-h)
                show_help; shift ;;
            version|--version)
                do_version; shift ;;
            update|--update)
                do_update; shift ;;
            *)
                console_err error "Unknown command: $1"
                console_err info "Run 'vulnscout --help' for usage."
                exit 1 ;;
        esac
    done

    # Auto-trigger scan if inputs were staged: one entrypoint call handles move + scan
    local _exit=0
    if [ "$SERVE_REQUESTED" = true ]; then
        ensure_running
        # Kill any previous Flask process to free port 7275
        call_container_engine exec "$CONTAINER_NAME" pkill -f 'flask.*run' 2>/dev/null || true
        sleep 1
        if [ "$DEV_MODE" = true ]; then
            start_frontend_dev
        fi
        exec_container --project "$PROJECT" --variant "$VARIANT" ${PENDING_ARGS[@]+"${PENDING_ARGS[@]}"} --serve || _exit=$?
    elif [ ${#PENDING_ARGS[@]} -gt 0 ]; then
        local -a scan_args=()
        [ -n "$MATCH_CONDITION" ] && scan_args+=(--match-condition "$MATCH_CONDITION")
        [ "${REFRESH_VULNERABILITY_DATA:-false}" = true ] && scan_args+=(--refresh-vulnerability-data)
        local -a scan_scope_args=()
        [ "$PROJECT_SPECIFIED" = true ] && scan_scope_args+=(--project "$PROJECT")
        [ "$VARIANT_SPECIFIED" = true ] && scan_scope_args+=(--variant "$VARIANT")
        exec_container "${scan_scope_args[@]}" "${PENDING_ARGS[@]}" "${scan_args[@]}" "${REPORT_ARGS[@]}" "${EXPORT_ARGS[@]}" || _exit=$?
    elif [ "${REFRESH_VULNERABILITY_DATA:-false}" = true ]; then
        local -a refresh_args=(--refresh-vulnerability-data)
        [ "$PROJECT_SPECIFIED" = true ] && refresh_args=(--project "$PROJECT" "${refresh_args[@]}")
        [ "$VARIANT_SPECIFIED" = true ] && refresh_args=(--variant "$VARIANT" "${refresh_args[@]}")
        exec_container "${refresh_args[@]}" || _exit=$?
    elif [[ "$DATA_REQUESTED" != "" ]]; then
        exec_container "--$DATA_REQUESTED" "${DATA_ARGS[@]}"
    elif [ -n "$MATCH_CONDITION" ] || [ ${#REPORT_ARGS[@]} -gt 0 ] || [ ${#EXPORT_ARGS[@]} -gt 0 ]; then
        # No new inputs but a match-condition, report, or export was given: run against existing DB data
        ensure_running
        local -a mc_args=()
        if [ -n "$MATCH_CONDITION" ]; then
            [ "$PROJECT_SPECIFIED" = true ] && mc_args+=(--project "$PROJECT")
        else
            mc_args+=(--project "$PROJECT")
        fi
        [ "$VARIANT_SPECIFIED" = true ] && mc_args+=(--variant "$VARIANT")
        [ -n "$MATCH_CONDITION" ] && mc_args+=(--match-condition "$MATCH_CONDITION")
        exec_container "${mc_args[@]}" "${REPORT_ARGS[@]}" "${EXPORT_ARGS[@]}" || _exit=$?
    fi
    return $_exit
}

main() {
    if [ $# -eq 0 ]; then
        show_help
        return 0
    fi
    if find_legacy_tokens "$@"; then
        warn_legacy_tokens
        parse_legacy "$@"
    else
        parse_new "$@"
    fi
}

main "$@"
